<?xml version="1.0" encoding="utf-8"?>
<!--
  Dasselbe wie backup_rules.xml, aber im Format ab Android 12 (API 31).
  Beide Dateien müssen existieren und im Manifest hängen, weil Android je
  nach Version die eine oder die andere liest.

  device-transfer ist hier ebenfalls ausgenommen: beim direkten
  Gerät-zu-Gerät-Umzug wäre das Token zwar nie in der Cloud, das Ergebnis
  (zwei Geräte mit derselben Sitzung) ist aber genauso wenig gewollt.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="CapacitorStorage.xml" />
    </device-transfer>
</data-extraction-rules>
